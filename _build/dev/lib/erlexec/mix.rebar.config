{hex,[{doc,ex_doc}]}.
{erl_opts,[debug_info,warn_export_all]}.
{pre_hooks,[{"(freebsd|netbsd|openbsd|dragonfly)",compile,"gmake -C c_src"},
            {"(linux|darwin|solaris)",compile,"make -C c_src"}]}.
{post_hooks,[{"(freebsd|netbsd|openbsd|dragonfly)",clean,
              "gmake -C c_src clean"},
             {"(linux|darwin|solaris)",clean,"make -C c_src clean"}]}.
{plugins,[rebar3_hex,{rebar3_ex_doc,"0.2.31"}]}.
{ex_doc,[{extras,[{"README.md",#{title => "Overview"}},
                  {"LICENSE",#{title => "License"}}]},
         {main,"README.md"},
         {source_url,"https://github.com/saleyn/erlexec"}]}.
{edoc_opts,[{def,{vsn,"70d33c120e340f8af8331b99cec6eeb3e1b19e83"}}]}.
{overrides,[]}.
