# Load testing Experiment

```elixir
Mix.install([
  {:experimentwizard, path: "./experimentwizard"},
  {:yaml_elixir, "~> 2.9.0"},
  {:kino_vega_lite, "~> 0.1.7"},
  {:kino_kroki, "~> 0.1.0"},
  {:kino_explorer, "~> 0.1.13"},
  {:explorer, "~> 0.8.0"},
  {:jason, "~> 1.4"}
])

Node.set_cookie(:cluster1)
```

## Experiment connection

```elixir
pid = Experimentwizard.Master.get_experiment_interface("manager")
experiment_name = "exwiztest"

Experimentwizard.Manager.experiment(pid, experiment_name)
|> Experimentwizard.Manager.credentials(experiment_name, %{
  certfile: "/home/etldrz/utahwork/cloudlab/putz/creds/cloudlab_decrypted.pem",
  cacertfile: "/home/etldrz/utahwork/cloudlab/putz/creds/emulab-ca.pem"
})
|> Experimentwizard.Manager.profile(experiment_name, "PowderSandbox,Repo-Based_Cluster")
|> Experimentwizard.Manager.project(experiment_name, "utahstud")

Experimentwizard.Manager.connect_or_start(pid, experiment_name)
```

## Yaml specifier

```elixir
yaml = """
is: client-server
requires:
  client: c
  server: s
  server_teardown: st
cells:
    c:
        targets:
            - executer@node1.exwiztest.utahstud.emulab.net
        commands:
            - sudo systemctl start apache2
        output: true
    s:
        targets:
            - executer@node2.exwiztest.utahstud.emulab.net
        commands:
            - echo "GET http://155.98.38.124/frankenstein.txt" | 
              vegeta attack -duration=5s | 
              tee results.bin | 
              vegeta report
        synchronous: false
    st:
        targets:
          - executer@node1.exwiztest.utahstud.emulab.net
        commands:
          - sudo systemctl end apache2
"""
yaml_result = Experimentwizard.RuntimeManager.parse_yaml_string(yaml)
```

```elixir
required_cells = yaml_result.requires
eval_pattern = yaml_result.is
all_cells = yaml_result.cells
```

```elixir
{graph, entry} =
  Experimentwizard.RuntimeManager.construct_graph_from_yaml(
    required_cells,
    eval_pattern,
    all_cells
  )

Graph.edges(graph)
```

```elixir
breakpoints = %{pre_breakpoints: MapSet.new() |> MapSet.put("s")}
```

```elixir
e = Experimentwizard.RuntimeManager.run_from_yaml(yaml_result, breakpoints)
```

```elixir
e = Experimentwizard.RuntimeManager.add_post_breakpoint(e, "st")
```

```elixir
env = Experimentwizard.Cell.resume(e, graph)
```

```elixir
env1 = Experimentwizard.Cell.resume(env, graph)
IO.inspect(env1.results)
```
