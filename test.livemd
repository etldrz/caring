```elixir

# ENTRY: node01

# options to specify flow rate for the commands and nodes
# maybe make MAX_CMDS a default that tells the
# manager the absolute max commmands that can be run at once?
# custom flow can be used to tag commands; the manager
# runs commands based on their rules and their usage tags.
# In the example below, a node can run 10 low usage at once, 3 med & 1 low, 
# or one high.

# MAX_CMDS: 10
# CUSTOM_FLOW {
# low: 1,
# med: 3,
# high: MAX_CMDS,
# }

# opt to repeat cmds? ie specify act01, then assign
# cmd rule1..10 act01;
# where 1..10 creates a range

# cmd NAME { ACTION } USAGE, TARGET;
cmd cmdA { do this } node01;
cmd cmdB { open that } node03;
  
cmd cmdC { turn that on && turn that off } low, node02;
cmd cmdD { turn that off && clean files } node02;

# raises error:
#run cmdA and cmdA;

# could designate cmds as 'immutable', ie each rule references
# only that command node. The converse means that each run reference
# to that command creates a new node.
run cmdA and cmdB then cmdC or cmdD;
# run cmdA or cmdB 
#   then cmdC and cmdD
#     then cmdA 
#       then cmdC and cmdD;

