```elixir
graph = """
graph LR;
cmdA <--> cmdB
cmdA --> cmdC
cmdB --> cmdC
cmdA --> cmdD
cmdB --> cmdD 
"""

Kino.Mermaid.new(graph)
```

```elixir
Kino.Mermaid.new("""
graph LR
  subsystem_A --> subsystem_B

  subgraph subsystem_B
    direction LR
    B1 --> B2 --> B3
  end
""")
```
